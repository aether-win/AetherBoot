diff --git a/INSTALL/grub/themes/aetherboot/theme.txt b/INSTALL/grub/themes/aetherboot/theme.txt
new file mode 100644
index 0000000..5740ee9
--- /dev/null
+++ b/INSTALL/grub/themes/aetherboot/theme.txt
@@ -0,0 +1,135 @@
+# ==========================================================================
+#  AetherBoot - tema oficial del menú de arranque
+#  Gestor de arranque multisistema basado en la tecnología Ventoy (GPLv3)
+#
+#  Diseñado para GRUB 2.04: los paneles son PNG con transparencia real
+#  (mezcla alfa); no hay animaciones ni desenfoque en vivo porque GRUB no
+#  los admite. Funciona en cualquier resolución: las posiciones son relativas.
+# ==========================================================================
+
+desktop-image: "background.png"
+desktop-image-scale-method: "crop"
+desktop-color: "#050b18"
+title-text: ""
+message-color: "#e2e8f0"
+message-bg-color: "#050b18"
+
+terminal-box: "terminal_box_*.png"
+
+# ---------------------------------------------------------- cabecera: logotipo
++ image {
+    left = 50%-230
+    top = 3%
+    width = 460
+    height = 98
+    file = "logo.png"
+}
+
+# versión y plataforma (variable de GRUB: AetherBoot <versión> UEFI/BIOS)
++ label {
+    left = 0
+    top = 3%+104
+    width = 100%
+    height = 20
+    align = "center"
+    color = "#22d3ee"
+    text = "@@VTOY_TEXT_MENU_VER"
+}
+
+# ------------------------------------------------- panel central (cristal)
++ boot_menu {
+  left = 12%
+  width = 76%
+  top = 3%+134
+  height = 79%-134
+
