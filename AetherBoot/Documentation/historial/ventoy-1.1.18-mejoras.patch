+
+    "theme": {
+        "file": [
+            "/ventoy/theme_moderno/theme.txt",
+            "/ventoy/theme/theme.txt"
+        ],
+        "default_file": 1,
+        "gfxmode": "1920x1080",
+        "display_mode": "GUI",
+        "ventoy_left": "15%",
+        "ventoy_top": "8%",
+        "ventoy_color": "#14b8a6"
+    },
+
+    "menu_tip": {
+        "left": "15%",
+        "top": "83%",
+        "color": "#94a3b8",
+        "tips": [
+            {
+                "image": "/ISO/Win11_Spanish_x64.iso",
+                "tip": "Instalación con cuenta local, sin TPM ni internet obligatorios"
+            },
+            {
+                "dir": "/ISO/rescate",
+                "tip": "Herramientas de rescate y reparación"
+            }
+        ]
