diff --git a/INSTALL/plugin/ventoy/theme_moderno/theme.txt b/INSTALL/plugin/ventoy/theme_moderno/theme.txt
new file mode 100644
index 0000000..ed6efe9
--- /dev/null
+++ b/INSTALL/plugin/ventoy/theme_moderno/theme.txt
@@ -0,0 +1,112 @@
+# Ventoy "moderno" theme
+# Dark background, teal accent, rounded menu panel and icons per image type.
+#
+# Enable it by copying this folder to /ventoy/theme_moderno on the Ventoy
+# partition and adding to /ventoy/ventoy.json:
+#
+#   "theme": {
+#       "file": "/ventoy/theme_moderno/theme.txt",
+#       "gfxmode": "1920x1080",
+#       "ventoy_left": "15%",
+#       "ventoy_top": "8%",
+#       "ventoy_color": "#14b8a6"
+#   }
+#
+# All artwork is generated by tools/make_theme.py (GPLv3, like Ventoy).
+
+desktop-image: "background.png"
+desktop-color: "#0b1120"
+title-text: ""
+message-color: "#e2e8f0"
+message-bg-color: "#0b1120"
+
+terminal-box: "terminal_box_*.png"
+
++ boot_menu {
+  left = 15%
+  width = 70%
+  top = 20%
+  height = 62%
+
+  menu_pixmap_style = "menu_*.png"
+
+  item_color = "#cbd5e1"
+  selected_item_color = "#ffffff"
+  selected_item_pixmap_style = "select_*.png"
+
+  item_height = 36
+  item_padding = 8
+  item_spacing = 4
+
+  icon_width = 28
+  icon_height = 28
+  item_icon_space = 14
+
+  scrollbar = true
+  scrollbar_width = 8
+  scrollbar_thumb = "slider_*.png"
+}
+
++ progress_bar {
+  id = "__timeout__"
+  text = "@TIMEOUT_NOTIFICATION_SHORT@"
+
+  left = 15%
+  width = 70%
+  top = 85%
+  height = 22
+
+  text_color = "#e2e8f0"
+  fg_color = "#14b8a6"
+  bg_color = "#1e293b"
+  border_color = "#334155"
+}
+
+# Ventoy status labels (filled in at runtime)
++ hbox {
+    left = 15%
+    top = 95%
+    width = 40%
+    height = 25
+    + label { text = "@VTOY_HOTKEY_TIP@" color = "#94a3b8" align = "left" }
+}
+
++ hbox {
+    left = 15%
+    top = 95%-25
+    width = 10%
+    height = 25
+    + label { text = "@VTOY_MEM_DISK@" color = "#fbbf24" align = "left" }
+}
+
++ hbox {
+    left = 15%
+    top = 95%-50
+    width = 10%
+    height = 25
+    + label { text = "@VTOY_ISO_RAW@" color = "#fbbf24" align = "left" }
+}
+
++ hbox {
+    left = 15%+200
+    top = 95%-50
+    width = 10%
+    height = 25
+    + label { text = "@VTOY_GRUB2_MODE@" color = "#fbbf24" align = "left" }
+}
+
++ hbox {
+    left = 15%+200
+    top = 95%-25
+    width = 10%
+    height = 25
+    + label { text = "@VTOY_WIMBOOT_MODE@" color = "#fbbf24" align = "left" }
+}
+
++ hbox {
+    left = 85%-120
+    top = 8%
+    width = 10%
+    height = 25
+    + label { text = "@VTOY_ISO_UEFI_DRV@" color = "#f87171" align = "left" }
+}
diff --git a/INSTALL/plugin/ventoy/ventoy_ejemplo_es.json b/INSTALL/plugin/ventoy/ventoy_ejemplo_es.json
new file mode 100644
index 0000000..2482464
